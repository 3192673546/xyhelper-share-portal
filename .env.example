# 基础设置
TZ=Asia/Shanghai
SITE_NAME=Pastel Share
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
OAUTH_SHARED_SECRET=CHANGE_ME_OAUTH_SECRET

# 首次运行 deploy.sh 时自动生成。不要在公开仓库提交真实值。
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_APP_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET
XYHELPER_ADMIN_PASSWORD=CHANGE_ME_XYHELPER_ADMIN_PASSWORD

# XYHelper 购买接入点后填写；下面是官方部署仓库的演示默认值。
CHATPROXY=https://demo.xyhelper.cn
AUTHKEY=xyhelper
AUDIT_LIMIT=40
AUDIT_PERIOD=3h

# 本机测试可保留 localhost；绑定域名后必须改成外部可访问的 HTTPS 地址。
PORTAL_BIND=0.0.0.0
PORTAL_PORT=8800
SHARE_BIND=0.0.0.0
SHARE_PORT=8300
PORTAL_PUBLIC_URL=http://localhost:8800
# auto 会沿用访问门户时的主机名并切换到 SHARE_PORT，适合首次用服务器 IP 测试。
SHARE_PUBLIC_URL=auto

# 账号策略
REGISTRATION_ENABLED=true
TRIAL_HOURS=0
SESSION_HOURS=168
HANDOFF_MINUTES=5

# 配置 HTTPS 域名后改为 true。若门户使用子域名，一般无需设置 COOKIE_DOMAIN。
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=false

# 易支付兼容接口；留空时关闭在线购买，兑换码和管理员开通仍可使用。
# XYHelper UCenter 示例：EPAY_URL=https://ucenter.example.com/easy/pay
EPAY_URL=
EPAY_PID=
EPAY_KEY=
EPAY_TYPE=alipay
EPAY_DEVICE=pc
# 常见易支付使用 append；若服务商要求 &key=密钥，改为 key_param。
EPAY_SIGN_MODE=append
